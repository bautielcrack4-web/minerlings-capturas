<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compila todos los scripts de unity_defensa contra las DLL del editor instalado (sin licencia ni ejecucion). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CS0649;CS0414;CS0169</NoWarn>
    <UnityManaged>/opt/unity/6000.0.84f1/Editor/Data/Managed</UnityManaged>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../unity_defensa/Assets/**/*.cs" />
    <Reference Include="$(UnityManaged)/UnityEngine/*.dll" Private="false" />
    <!-- AdMob (paquete com.google.ads.mobile 11.5.0): check.sh lo baja de OpenUPM a ~/.cache/fortin_gma -->
    <Reference Include="$(HOME)/.cache/fortin_gma/*.dll" Private="false" />
    <Reference Include="/opt/unity/6000.0.84f1/Editor/Data/Resources/PackageManager/ProjectTemplates/libcache/com.unity.template.3d-cross-platform-17.0.12/ScriptAssemblies/UnityEngine.UI.dll" Private="false" />
  </ItemGroup>
</Project>
