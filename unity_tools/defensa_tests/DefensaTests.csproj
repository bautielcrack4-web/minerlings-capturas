<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pruebas del nucleo de Fortin de Juguete (unity_defensa/Assets/Scripts/Core) y bots de balance.
       Uso: dotnet run -c Release, con argumento balance, tune o quick -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- C# 9 como maximo: es lo que soporta Unity 6 -->
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>DefensaTests</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../unity_defensa/Assets/Scripts/Core/**/*.cs" />
    <Compile Include="*.cs" />
  </ItemGroup>
</Project>
